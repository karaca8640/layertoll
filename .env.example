# LayerToll configuration. Copy to .env (git-ignored) or run:
#   python scripts/generate_env.py        # fills random local passwords/keys
# Never commit real values. Everything below is a placeholder.

# ---------------------------------------------------------------- database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=__set_me__
MYSQL_DB=layertoll

# ---------------------------------------------------------------- cache / queue (upstream legacy billing)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__set_me__
REDIS_DB=0
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=layertoll
RABBITMQ_PASSWORD=__set_me__
RABBITMQ_VHOST=/
BILLING_QUEUE_NAME=billing.api.calls

# ---------------------------------------------------------------- services
API_PORT=8002
ADMIN_PORT=8001
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
# Host port for the all-in-one container (nginx -> frontend / admin / agent gateway)
LAYERTOLL_PORT=8000

# AES-256 key (base64, 32 bytes) used by upstream code to encrypt legacy payment-channel configs
PAYMENT_CONFIG_SECRET_KEY=
PAYMENT_CONFIG_KEY_ID=default

# ---------------------------------------------------------------- X Layer / x402 (LayerToll)
# xlayer-mainnet (eip155:196, USDT0) or xlayer-testnet (eip155:1952)
AGENTPAY_NETWORK=xlayer-mainnet
# Optional RPC override (defaults: https://rpc.xlayer.tech / https://xlayertestrpc.okx.com)
XLAYER_RPC_URL=
# Public origin agents use. OKX AI A2MCP listings require a public HTTPS URL.
AGENTPAY_PUBLIC_BASE_URL=http://localhost:8000
# Default payout wallet for paid tools (a service can set its own). Public address only.
AGENTPAY_DEFAULT_PAYOUT_WALLET=
AGENTPAY_PAYMENT_TIMEOUT_SECONDS=300
AGENTPAY_UPSTREAM_TIMEOUT_SECONDS=20
# Re-check every settlement tx on the X Layer RPC (Transfer of USDT0 to payTo)
AGENTPAY_VERIFY_ONCHAIN=true
# Where the gateway reaches itself / the bundled demo API from inside the container
AGENTPAY_API_INTERNAL_URL=http://127.0.0.1:8002
DEMO_API_BASE_URL=http://127.0.0.1:8002/demo-api

# OKX x402 facilitator (OKX Web3 developer-portal API credentials).
# Without these, paid tools still return HTTP 402 but every payment is rejected (fail closed).
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_FACILITATOR_BASE_URL=https://web3.okx.com
